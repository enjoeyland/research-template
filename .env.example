# Copy to ".env" and fill in your values:   cp .env.example .env     (.env is gitignored -- never commit it)
#
# Plain KEY=value lines (no `export`, no spaces around `=`); `${USER}` is expanded.
# src/train.py, src/eval.py, src/analyze.py load it automatically (rootutils), and Hydra configs can use any variable as
# ${oc.env:NAME} or ${oc.env:NAME,default}. scripts/sbatch/common/env.sh reads ONLY VENV and CHECKPOINT_DIR (never the
# whole file, it may hold API keys). Your own scripts do NOT get it: `set -a; source .env; set +a` first.

# --- storage ---------------------------------------------------------------------------------------------------
#   /lustre/<user>/   = kept long-term (checkpoints, results worth keeping)
#   /scratch2/<user>/ = may be wiped (caches, tmp, venvs)

# Checkpoints go here instead of <repo>/logs/runs/<experiment>/checkpoints (which then becomes a symlink to it, so the
# experiment folder still shows logs, checkpoints and results together).
CHECKPOINT_DIR=/lustre/${USER}/checkpoints/<project>

# Pretrained weights / downloaded models go to scratch2, not ~/.cache.
HUGGINGFACE_HUB_CACHE=/scratch2/${USER}/cache
TMPDIR=/scratch2/${USER}/tmp

# --- optional ---------------------------------------------------------------------------------------------------
# Python venv for scripts/sbatch. Default: /scratch2/$USER/venvs/<repo folder name>
# VENV=/scratch2/${USER}/venvs/<project>

TOKENIZERS_PARALLELISM=false

# Use only the local HF cache (no network freshness check). A stuck node's network call can hang a whole job; with this a
# not-yet-cached model fails fast with a clear error instead. Turn on once the models you need are cached.
# HF_HUB_OFFLINE=1

# wandb (logger=wandb): `wandb login` once (~/.netrc is shared with compute nodes) or set the key here.
# Project defaults to the repo folder name; override with WANDB_PROJECT or `logger.wandb.project=<name>`.
# WANDB_API_KEY=
# WANDB_PROJECT=
# WANDB_ENTITY=
# WANDB_MODE=offline

# Tokens, only if you use them.
# HF_TOKEN=
