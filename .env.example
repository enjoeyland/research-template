# Copy to ".env" and fill in your values:   cp .env.example .env     (.env is gitignored -- never commit it)
#
# Format: plain KEY=value lines (no `export`, no spaces around `=`, no quotes needed).
#
# Who reads this file:
#   * src/train.py, src/eval.py, src/analyze.py load it automatically (rootutils), and Hydra configs can refer to
#     any variable as ${oc.env:NAME} or ${oc.env:NAME,default}.
#   * scripts/sbatch/common/env.sh reads ONLY VENV and CHECKPOINT_DIR (it never sources the whole file, since it may
#     hold API keys).
#   * your own ad-hoc scripts do NOT get it automatically: run `set -a; source .env; set +a` first.
# Lines without a leading `#` (the cache paths) are the defaults to keep; commented lines are optional, and an unset
# one falls back to the default noted next to it.

# --- paths -----------------------------------------------------------------------------------------------------
# Storage convention:  /lustre/<user>/  = kept long-term (checkpoints, results worth keeping)
#                      /scratch2/<user>/ = may be wiped (caches, tmp, venvs)
# Where checkpoints go (configs/paths/default.yaml). Default: <repo>/logs/runs/<experiment>/checkpoints.
# Point it at /lustre; <repo>/logs/runs/<experiment>/checkpoints then becomes a symlink to it, so the experiment
# folder (train/ eval/ analyze/ checkpoints/) still shows everything in one place.
#   Layout: $CHECKPOINT_DIR/runs/<experiment_name>/checkpoints/seed<N>_epoch_XXX.ckpt
# CHECKPOINT_DIR=/lustre/<user>/checkpoints/<project>

# (no data path here: datasets are always read from <repo>/data. Heavy ones are SYMLINKED into data/, see data/README.md)

# --- compute ---------------------------------------------------------------------------------------------------
# Python venv used by scripts/sbatch (activated for every sweep job).
# Default: /scratch2/$USER/venvs/<repo folder name>
# VENV=/scratch2/<user>/venvs/<project>

# Caches (pretrained weights, downloaded datasets, wandb / matplotlib / triton / pip) go to /scratch2 -- NOT ~/.cache
# (home is small). Libraries read these variables when they are imported, and train/eval/analyze load this file first.
# `${USER}` is expanded. (For your own scripts: `set -a; source .env; set +a` before importing torch / transformers.)
HF_HOME=/scratch2/${USER}/cache/huggingface
TORCH_HOME=/scratch2/${USER}/cache/torch
TORCH_EXTENSIONS_DIR=/scratch2/${USER}/cache/torch_extensions
TRITON_CACHE_DIR=/scratch2/${USER}/cache/triton
XDG_CACHE_HOME=/scratch2/${USER}/cache/xdg
WANDB_CACHE_DIR=/scratch2/${USER}/cache/wandb
WANDB_DATA_DIR=/scratch2/${USER}/cache/wandb/data
MPLCONFIGDIR=/scratch2/${USER}/cache/matplotlib
PIP_CACHE_DIR=/scratch2/${USER}/cache/pip

# --- experiment tracking (logger=wandb, configs/logger/wandb.yaml) ---------------------------------------------
# Either `wandb login` once (stored in ~/.netrc, shared with compute nodes) or set the key here.
# WANDB_API_KEY=
# wandb project name. Default: the repo folder name (so each research project names itself); set it to override.
# Or per run: logger.wandb.project=<name>
# WANDB_PROJECT=
# Your wandb user or team. Default: your default entity.
# WANDB_ENTITY=
# Run without network (e.g. a compute node without internet): sync later with `wandb sync`.
# WANDB_MODE=offline

# --- other secrets / tokens (only if you use them) -------------------------------------------------------------
# HF_TOKEN=
