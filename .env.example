# copy this file to ".env" and fill in your own values (.env is gitignored)
# .env is loaded automatically by src/train.py, src/eval.py, src/analyze.py (rootutils)
# hydra allows you to reference variables in .yaml configs with special syntax: ${oc.env:MY_VAR}

# path to data directory (used by configs/paths/default.yaml)
DATA_DIR=

# python venv used by scripts/sbatch (default: /scratch2/$USER/venvs/<repo folder name>)
# VENV=

# optional: redirect checkpoints to shared/large storage instead of logs/<task_name>/runs/...
# CHECKPOINT_DIR=/lustre/<user>/checkpoints/<project>

# optional: API keys / tokens used by loggers, HF, etc.
# HF_TOKEN=
# WANDB_API_KEY=
